---
export interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl?: string;
}

const { currentPage, totalPages, baseUrl = '/' } = Astro.props;

if (totalPages <= 1) {
  return;
}

function getPageUrl(page: number) {
  if (page === 1) {
    return baseUrl;
  }
  return `/page/${page}/`;
}

const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<div class="post-navigation d-flex justify-content-between align-items-center mt-4">
  {currentPage > 1 ? (
    <a href={getPageUrl(currentPage - 1)} class="btn btn-outline-primary btn-sm" aria-label="Previous page">
      <i class="fas fa-chevron-left me-1"></i> Older
    </a>
  ) : (
    <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">
      <i class="fas fa-chevron-left me-1"></i> Older
    </span>
  )}

  <div class="pagination-numbers d-flex gap-1">
    {pages.map((p) => {
      const isCurrent = p === currentPage;
      return (
        <a
          href={getPageUrl(p)}
          class={`btn btn-sm ${isCurrent ? 'btn-primary' : 'btn-outline-secondary'}`}
          aria-current={isCurrent ? 'page' : undefined}
        >
          {p}
        </a>
      );
    })}
  </div>

  {currentPage < totalPages ? (
    <a href={getPageUrl(currentPage + 1)} class="btn btn-outline-primary btn-sm" aria-label="Next page">
      Newer <i class="fas fa-chevron-right ms-1"></i>
    </a>
  ) : (
    <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">
      Newer <i class="fas fa-chevron-right ms-1"></i>
    </span>
  )}
</div>
