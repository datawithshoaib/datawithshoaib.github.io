---
export interface Props {
  title: string;
  url: string;
  date?: Date | null;
  description?: string | null;
  excerpt?: string | null;
  image?: string | { path?: string | null; alt?: string | null } | null;
  categories?: string[];
  pin?: boolean | null;
}

const {
  title,
  url,
  date,
  description,
  excerpt,
  image,
  categories = [],
  pin = false,
} = Astro.props;

let imageSrc: string | undefined;
let imageAlt = title;

if (typeof image === 'string') {
  imageSrc = image;
} else if (image && typeof image === 'object' && image.path) {
  imageSrc = image.path;
  if (image.alt) imageAlt = image.alt;
}

if (imageSrc && !imageSrc.startsWith('http') && !imageSrc.startsWith('/')) {
  imageSrc = '/' + imageSrc;
}

const summaryText = description || excerpt || '';
const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';
---

<article class="card-wrapper card">
  <a href={url} class="post-preview row g-0 flex-md-row-reverse">
    {imageSrc && (
      <div class="col-md-5">
        <div class="preview-img">
          <img src={imageSrc} alt={imageAlt} loading="lazy" />
        </div>
      </div>
    )}

    <div class={imageSrc ? 'col-md-7' : 'col-md-12'}>
      <div class="card-body d-flex flex-column">
        <h1 class="card-title my-2 mt-md-0">{title}</h1>

        {summaryText && (
          <div class="card-text content mt-0 mb-3">
            <p>{summaryText}</p>
          </div>
        )}

        <div class="post-meta flex-grow-1 d-flex align-items-end">
          <div class="me-auto">
            {formattedDate && (
              <span>
                <i class="far fa-calendar fa-fw me-1"></i>
                <time>{formattedDate}</time>
              </span>
            )}

            {categories && categories.length > 0 && (
              <span class="ms-3 categories">
                <i class="far fa-folder-open fa-fw me-1"></i>
                <span>{categories.join(', ')}</span>
              </span>
            )}
          </div>

          {pin && (
            <div class="pin">
              <i class="fas fa-thumbtack fa-fw"></i>
              <span>Pinned</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </a>
</article>
