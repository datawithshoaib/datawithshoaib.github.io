---
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import type { MarkdownHeading } from 'astro';

export interface Props {
  title: string;
  description?: string | null;
  date?: Date | null;
  lastModifiedAt?: Date | null;
  author?: string | null;
  image?: string | { path?: string | null; alt?: string | null } | null;
  categories?: string[];
  tags?: string[];
  headings?: MarkdownHeading[];
  enableToc?: boolean;
  prevPost?: { title: string; url: string } | null;
  nextPost?: { title: string; url: string } | null;
}

const {
  title,
  description,
  date,
  lastModifiedAt,
  author = 'Shoaib Akthar',
  image,
  categories = [],
  tags = [],
  headings = [],
  enableToc = true,
  prevPost,
  nextPost,
} = Astro.props;

let imageSrc: string | undefined;
let imageAlt = title;

if (typeof image === 'string') {
  imageSrc = image;
} else if (image && typeof image === 'object' && image.path) {
  imageSrc = image.path;
  if (image.alt) imageAlt = image.alt;
}

if (imageSrc && !imageSrc.startsWith('http') && !imageSrc.startsWith('/')) {
  imageSrc = '/' + imageSrc;
}

const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : null;

const formattedUpdated = lastModifiedAt
  ? new Date(lastModifiedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : null;

const currentUrl = Astro.url.href;
const primaryCategory = categories.length > 0 ? categories[0] : undefined;
---

<BaseLayout
  title={title}
  description={description || undefined}
  image={imageSrc}
  type="article"
  headings={headings}
  enableToc={enableToc}
  category={primaryCategory}
>
  <article class="px-1">
    <header>
      <h1 class="mb-3">{title}</h1>

      {description && <p class="post-desc fw-light mb-4 text-muted">{description}</p>}

      <div class="post-meta text-muted mb-4 pb-3 border-bottom">
        <div class="d-flex flex-wrap align-items-center gap-3">
          {formattedDate && (
            <span>
              <i class="far fa-calendar-alt me-1"></i>
              <span>{formattedDate}</span>
            </span>
          )}

          {formattedUpdated && formattedUpdated !== formattedDate && (
            <span>
              <i class="fas fa-history me-1"></i>
              <span>Updated {formattedUpdated}</span>
            </span>
          )}

          <span>
            <i class="far fa-user me-1"></i>
            <span>{author}</span>
          </span>

          {categories.length > 0 && (
            <span>
              <i class="far fa-folder-open me-1"></i>
              {categories.map((cat, idx) => (
                <span>
                  <a href={`/categories/${encodeURIComponent(cat.toLowerCase())}/`}>{cat}</a>
                  {idx < categories.length - 1 ? ', ' : ''}
                </span>
              ))}
            </span>
          )}
        </div>

        {imageSrc && (
          <div class="preview-img mt-3 mb-3 rounded shadow-sm">
            <img src={imageSrc} alt={imageAlt} class="w-100 rounded" />
          </div>
        )}
      </div>
    </header>

    <div class="content mb-5">
      <slot />
    </div>

    <div class="post-tail-wrapper text-muted pt-4 border-top">
      {tags.length > 0 && (
        <div class="post-tags mb-4">
          <i class="fas fa-tags me-2 text-muted"></i>
          {tags.map((tag) => (
            <a
              class="post-tag btn btn-outline-primary btn-sm me-1 mb-1"
              href={`/tags/${encodeURIComponent(tag.toLowerCase())}/`}
            >
              {tag}
            </a>
          ))}
        </div>
      )}

      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <ShareButtons title={title} url={currentUrl} />
      </div>

      {(prevPost || nextPost) && (
        <nav class="post-navigation row g-2 mt-4 pt-3 border-top" aria-label="Post Navigation">
          <div class="col-6">
            {prevPost && (
              <a href={prevPost.url} class="btn btn-outline-secondary w-100 text-start text-truncate" title={prevPost.title}>
                <i class="fas fa-chevron-left me-1"></i>
                <span>{prevPost.title}</span>
              </a>
            )}
          </div>
          <div class="col-6 text-end">
            {nextPost && (
              <a href={nextPost.url} class="btn btn-outline-secondary w-100 text-end text-truncate" title={nextPost.title}>
                <span>{nextPost.title}</span>
                <i class="fas fa-chevron-right ms-1"></i>
              </a>
            )}
          </div>
        </nav>
      )}
    </div>
  </article>
</BaseLayout>
