---
// This page generates redirect pages for old /posts/YYYY/MM/slug/ URLs
// to their new /blog/slug/ locations.

export function getStaticPaths() {
  const oldToNew: Record<string, string> = {
    '2025/03/ai-900-preparation-notes': '/blog/ai-900-preparation-notes/',
    '2025/01/az-900-practice-questions': '/blog/az-900-practice-questions/',
    '2025/04/what-is-azure-ai-foundry': '/blog/what-is-azure-ai-foundry/',
    '2024/12/azure-data-flow-conditional-flatten': '/blog/azure-data-flow-conditional-flatten/',
    '2024/12/azure-data-flow-conditional-split': '/blog/azure-data-flow-conditional-split/',
    '2024/12/azure-data-flow-derived-columns': '/blog/azure-data-flow-derived-columns/',
    '2024/12/configuring-azure-data-flow-error-handling': '/blog/configuring-azure-data-flow-error-handling/',
    '2025/04/prepare-for-an-ai-development-project': '/blog/prepare-for-an-ai-development-project/',
    '2025/05/choose-and-deploy-a-language-model': '/blog/choose-and-deploy-a-language-model/',
    '2025/05/develop-a-multimodal-generative-ai-app': '/blog/develop-a-multimodal-generative-ai-app/',
    '2025/05/use-prompt-flow-to-manage-conversation-in-chat-app': '/blog/use-prompt-flow-to-manage-conversation-in-chat-app/',
    '2025/05/create-a-generative-ai-app-that-uses-your-own-data': '/blog/create-a-generative-ai-app-that-uses-your-own-data/',
    '2025/05/fine-tune-apply-content-filter-lang-model': '/blog/fine-tune-apply-content-filter-lang-model/',
    '2025/04/create-and-manage-azure-resources': '/blog/create-and-manage-azure-resources/',
    '2024/12/azure-virtual-machine': '/blog/azure-virtual-machine/',
    '2026/10/building-fastapi-backend-with-supabase': '/blog/building-fastapi-backend-with-supabase/',
    '2025/04/dp-100-preparation-notes': '/blog/dp-100-preparation-notes/',
    '2025/01/dp-900-practice-questions': '/blog/dp-900-practice-questions/',
    '2026/06/fabric-key-concepts': '/blog/fabric-key-concepts/',
    '2026/09/finding-best-free-tech-stack-for-web-apps': '/blog/finding-best-free-tech-stack-for-web-apps/',
    '2024/12/handling-duplicate-data-in-azure-data-flows': '/blog/handling-duplicate-data-in-azure-data-flows/',
    '2024/12/configure-hierarchical-namespace-azure-data-lake': '/blog/configure-hierarchical-namespace-azure-data-lake/',
    '2025/07/import-to-postgresql': '/blog/import-to-postgresql/',
    '2025/02/powerbi-certified': '/blog/powerbi-certified/',
    '2024/12/my-first-app-in-power-apps': '/blog/my-first-app-in-power-apps/',
    '2025/03/15-days-of-dax-series': '/blog/15-days-of-dax-series/',
    '2025/09/top50-pbi-qns': '/blog/top50-pbi-qns/',
    '2025/01/importing-excel-data-into-sharepoint-list-using-power-automate': '/blog/importing-excel-data-into-sharepoint-list-using-power-automate/',
    '2024/12/pricing-calculator-in-azure': '/blog/pricing-calculator-in-azure/',
    '2024/12/resource-lock-in-azure': '/blog/resource-lock-in-azure/',
    '2024/10/sampling-distributions': '/blog/sampling-distributions/',
    '2024/12/enable-security-for-azure-data-lake': '/blog/enable-security-for-azure-data-lake/',
    '2024/12/storage-blob-in-azure': '/blog/storage-blob-in-azure/',
    '2024/12/tco-calculator-in-azure': '/blog/tco-calculator-in-azure/',
    '2026/09/understanding-a-python-configuration-class-from-environment-variables-to-frozen-dataclasses': '/blog/understanding-a-python-configuration-class-from-environment-variables-to-frozen-dataclasses/',
    '2026/09/understanding-dataclass-from-first-principles': '/blog/understanding-dataclass-from-first-principles/',
    '2026/06/understanding-gridsearchcv': '/blog/understanding-gridsearchcv/',
    '2026/09/what-is-jev': '/blog/what-is-jev/',
    '2026/09/why-from-__future__-import-annotations-exists': '/blog/why-from-__future__-import-annotations-exists/',
    '2025/12/why-subtract-3-in-word-index-in-IMDb-dataset-tensorflow': '/blog/why-subtract-3-in-word-index-in-IMDb-dataset-tensorflow/',
  };

  return Object.entries(oldToNew).map(([oldSlug, newUrl]) => ({
    params: { slug: oldSlug },
    props: { newUrl },
  }));
}

const { newUrl } = Astro.props;
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0;url=${newUrl}`} />
  <link rel="canonical" href={newUrl} />
  <title>Redirecting...</title>
</head>
<body>
  <p>This page has moved. <a href={newUrl}>Click here</a> if you are not redirected.</p>
</body>
</html>
