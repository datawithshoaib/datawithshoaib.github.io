---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

type NoteBlock =
  | { type: 'paragraph'; text: string }
  | { type: 'list'; items: string[] };

const colorClasses = [
  'thought-card--yellow',
  'thought-card--lavender',
  'thought-card--mint',
  'thought-card--peach',
  'thought-card--blue',
];

function slugify(value: string) {
  return value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-');
}

function parseNoteBody(rawBody: string): NoteBlock[] {
  return rawBody
    .split(/\r?\n\r?\n/)
    .map((block) => block.trim())
    .filter(Boolean)
    .map((block) => {
      const lines = block
        .split(/\r?\n/)
        .map((line) => line.trim())
        .filter(Boolean);
      const isList = lines.length > 0 && lines.every((line) => /^([-*+]|\d+\.)\s+/.test(line));

      if (isList) {
        return {
          type: 'list',
          items: lines.map((line) => line.replace(/^([-*+]|\d+\.)\s+/, '').trim()),
        } as NoteBlock;
      }

      return { type: 'paragraph', text: block.replace(/\r?\n/g, ' ') } as NoteBlock;
    });
}

function formatDate(value?: Date | null) {
  if (!value) return '';
  return new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' }).format(value);
}

const entries = await getCollection('thoughts');
const source = entries[0];
const raw = ((source as unknown as { body?: string })?.body ?? '').trim();
const updatedAt = formatDate((source?.data as { date?: Date | null } | undefined)?.date);

const headingMatches = [...raw.matchAll(/^#{1,6}\s+(.+)$/gm)];

const notes = headingMatches.map((match, index) => {
  const title = match[1].trim();
  const start = (match.index ?? 0) + match[0].length;
  const end = headingMatches[index + 1]?.index ?? raw.length;
  return {
    title,
    id: `thought-${slugify(title)}`,
    colorClass: colorClasses[index % colorClasses.length],
    blocks: parseNoteBody(raw.slice(start, end).trim()),
  };
});
---

<BaseLayout
  title="Thoughts"
  description="Random thoughts, quick reflections, and ideas captured on sticky notes."
>
  <div class="thoughts-container px-1">
    <header class="thoughts-header mb-4">
      <span class="thoughts-eyebrow"><i class="fas fa-note-sticky me-1"></i> Thoughts</span>
      <h1 class="dynamic-title mb-2">Random Thoughts</h1>
      <p class="lead text-muted mb-2">
        Fleeting ideas, quick reflections, and things I don't want to forget &mdash; captured as sticky notes.
      </p>
      {updatedAt && (
        <p class="thoughts-updated mb-0">
          <i class="far fa-clock me-1"></i>Last updated {updatedAt}
        </p>
      )}
    </header>

    {notes.length ? (
      <div class="thoughts-grid">
        {notes.map((note) => (
          <article class={`thought-card ${note.colorClass}`} id={note.id}>
            <span class="thought-card-pin" aria-hidden="true"></span>
            <h3 class="thought-card-title">{note.title}</h3>
            <div class="thought-card-body">
              {note.blocks.length ? (
                note.blocks.map((block) =>
                  block.type === 'list' ? (
                    <ul>{block.items.map((item) => <li>{item}</li>)}</ul>
                  ) : (
                    <p>{block.text}</p>
                  )
                )
              ) : (
                <p class="thought-card-empty">Nothing here yet.</p>
              )}
            </div>
            <div class="thought-card-actions">
              <button
                type="button"
                class="thought-action thought-copy"
                aria-label={`Copy link to ${note.title}`}
                title="Copy link"
              >
                <i class="fas fa-link"></i>
              </button>
              <a class="thought-action thought-x" target="_blank" rel="noopener noreferrer" aria-label={`Share ${note.title} on X`} title="Share on X">
                <i class="fab fa-x-twitter"></i>
              </a>
              <a class="thought-action thought-linkedin" target="_blank" rel="noopener noreferrer" aria-label={`Share ${note.title} on LinkedIn`} title="Share on LinkedIn">
                <i class="fab fa-linkedin-in"></i>
              </a>
              <a class="thought-action thought-email" aria-label={`Share ${note.title} via email`} title="Share via email">
                <i class="fas fa-envelope"></i>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="thoughts-empty text-center py-5">
        <i class="fas fa-note-sticky fa-2x text-muted mb-3"></i>
        <p class="text-muted mb-0">
          No thoughts yet. Add <code>##</code> headings to <code>src/content/thoughts/thoughts.md</code> to create sticky notes.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
.thoughts-eyebrow {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--link-color, #0056b2);
  background-color: rgba(0, 86, 178, 0.1);
  border: 1px solid rgba(0, 86, 178, 0.22);
  padding: 0.32rem 0.7rem;
  border-radius: 9999px;
  margin-bottom: 0.85rem;
}

.thoughts-updated {
  font-size: 0.82rem;
  color: var(--text-muted-color, #757575);
}

.thoughts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1.6rem;
  align-items: start;
  padding-top: 0.5rem;
}

.thought-card {
  --note-bg: #fff6b0;
  --note-ink: #4a4413;
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 190px;
  padding: 1.5rem 1.25rem 1rem;
  border-radius: 3px 3px 8px 8px;
  background-color: var(--note-bg);
  color: var(--note-ink);
  border: 1px solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 12px 20px -12px rgba(0, 0, 0, 0.45), 0 2px 5px rgba(0, 0, 0, 0.08);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  overflow: hidden;
}

.thought-card:nth-child(4n + 1) { transform: rotate(-1.2deg); }
.thought-card:nth-child(4n + 2) { transform: rotate(0.9deg); }
.thought-card:nth-child(4n + 3) { transform: rotate(-0.7deg); }
.thought-card:nth-child(4n + 4) { transform: rotate(1.1deg); }

.thought-card:hover {
  transform: rotate(0deg) translateY(-5px);
  box-shadow: 0 22px 32px -14px rgba(0, 0, 0, 0.5), 0 3px 7px rgba(0, 0, 0, 0.1);
  z-index: 2;
}

.thought-card-pin {
  position: absolute;
  top: 0;
  left: 50%;
  width: 54px;
  height: 16px;
  transform: translateX(-50%);
  background-color: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-top: none;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
}

.thought-card--yellow { --note-bg: #fff6b0; --note-ink: #4a4413; }
.thought-card--lavender { --note-bg: #e9defb; --note-ink: #3d2f57; }
.thought-card--mint { --note-bg: #d3f5e2; --note-ink: #1f4a37; }
.thought-card--peach { --note-bg: #ffe1cc; --note-ink: #5a3320; }
.thought-card--blue { --note-bg: #d6e8ff; --note-ink: #223b5c; }

.thought-card-title {
  font-size: 1.05rem;
  font-weight: 700;
  line-height: 1.3;
  margin: 0 0 0.7rem;
  padding-bottom: 0.55rem;
  color: inherit;
  border-bottom: 1px solid rgba(0, 0, 0, 0.13);
}

.thought-card-body {
  flex: 1 1 auto;
  font-size: 0.9rem;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.thought-card-body p {
  margin: 0 0 0.6rem;
}

.thought-card-body p:last-child {
  margin-bottom: 0;
}

.thought-card-body ul {
  margin: 0 0 0.6rem;
  padding-left: 1.1rem;
}

.thought-card-body li {
  margin-bottom: 0.25rem;
}

.thought-card-body li:last-child {
  margin-bottom: 0;
}

.thought-card-actions {
  display: flex;
  gap: 0.4rem;
  margin-top: 1.1rem;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(0, 0, 0, 0.1);
  opacity: 0.5;
  transition: opacity 0.2s ease;
}

.thought-card:hover .thought-card-actions,
.thought-card:focus-within .thought-card-actions {
  opacity: 1;
}

.thought-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border: none;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.55);
  color: inherit;
  font-size: 0.78rem;
  cursor: pointer;
  text-decoration: none;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.thought-action:hover {
  background-color: rgba(255, 255, 255, 0.9);
  color: inherit;
  transform: translateY(-1px);
}

.thoughts-empty code {
  font-size: 0.8rem;
  background-color: var(--btn-border-color, #e9ecef);
  padding: 0.1rem 0.35rem;
  border-radius: 4px;
}

html[data-mode='dark'] .thought-card--yellow { --note-bg: #443f1b; --note-ink: #f6efc2; }
html[data-mode='dark'] .thought-card--lavender { --note-bg: #33294d; --note-ink: #e6dcff; }
html[data-mode='dark'] .thought-card--mint { --note-bg: #1d3d2f; --note-ink: #c9f2df; }
html[data-mode='dark'] .thought-card--peach { --note-bg: #472d1e; --note-ink: #ffe0cc; }
html[data-mode='dark'] .thought-card--blue { --note-bg: #21374e; --note-ink: #d6e8ff; }

html[data-mode='dark'] .thought-card {
  border-color: rgba(255, 255, 255, 0.08);
  box-shadow: 0 12px 22px -12px rgba(0, 0, 0, 0.75), 0 2px 5px rgba(0, 0, 0, 0.4);
}

html[data-mode='dark'] .thought-card-pin {
  background-color: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.08);
}

html[data-mode='dark'] .thought-card-title {
  border-bottom-color: rgba(255, 255, 255, 0.16);
}

html[data-mode='dark'] .thought-card-actions {
  border-top-color: rgba(255, 255, 255, 0.14);
}

html[data-mode='dark'] .thought-action {
  background-color: rgba(255, 255, 255, 0.12);
}

html[data-mode='dark'] .thought-action:hover {
  background-color: rgba(255, 255, 255, 0.24);
}

html[data-mode='dark'] .thoughts-eyebrow {
  color: #7fb3ff;
  background-color: rgba(127, 179, 255, 0.12);
  border-color: rgba(127, 179, 255, 0.28);
}

@media (max-width: 575px) {
  .thoughts-grid {
    grid-template-columns: 1fr;
  }

  .thought-card {
    transform: none;
  }

  .thought-card:hover {
    transform: translateY(-4px);
  }
}
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const base = window.location.origin + window.location.pathname;

    document.querySelectorAll('.thought-card').forEach((card) => {
      const id = card.id || '';
      const title = card.querySelector('.thought-card-title')?.textContent?.trim() || 'Thought';
      const url = id ? `${base}#${id}` : base;

      const copyButton = card.querySelector('.thought-copy');
      const xLink = card.querySelector('.thought-x');
      const linkedinLink = card.querySelector('.thought-linkedin');
      const emailLink = card.querySelector('.thought-email');

      if (copyButton) {
        copyButton.addEventListener('click', async () => {
          const icon = copyButton.querySelector('i');
          const original = icon ? icon.className : '';
          try {
            await navigator.clipboard.writeText(url);
            if (icon) {
              icon.className = 'fas fa-check';
              setTimeout(() => {
                icon.className = original;
              }, 1500);
            }
          } catch {
            window.prompt('Copy this link:', url);
          }
        });
      }

      if (xLink) {
        xLink.setAttribute(
          'href',
          `https://x.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(`A thought from Shoaib: ${title}`)}`
        );
      }

      if (linkedinLink) {
        linkedinLink.setAttribute(
          'href',
          `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`
        );
      }

      if (emailLink) {
        emailLink.setAttribute(
          'href',
          `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`
        );
      }
    });
  });
</script>
