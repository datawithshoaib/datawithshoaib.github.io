---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeetCodeCard from '../components/LeetCodeCard.astro';
import { siteConfig } from '../data/site';
import { getProblems, getCourses, getJournal, getActivity, courseUrl, formatDate, dayKey } from '../utils/learning';

const [problems, courses, journal, activity] = await Promise.all([getProblems(), getCourses(), getJournal(), getActivity()]);

const solved = problems.filter((p) => p.data.status === 'solved');
const inProgress = courses.filter((c) => c.data.status === 'in-progress');
const completed = courses.filter((c) => c.data.status === 'completed');

// Heatmap: the last 53 weeks up to the build date, starting on a Sunday.
const perDay = new Map<string, number>();
for (const a of activity) perDay.set(dayKey(a.date), (perDay.get(dayKey(a.date)) ?? 0) + 1);

const today = new Date();
const todayUtc = new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()));
const start = new Date(todayUtc);
start.setUTCDate(start.getUTCDate() - 52 * 7 - start.getUTCDay());

const cells: { key: string; count: number; future: boolean }[] = [];
for (let d = new Date(start); cells.length < 53 * 7; d.setUTCDate(d.getUTCDate() + 1)) {
  const key = dayKey(d);
  cells.push({ key, count: perDay.get(key) ?? 0, future: d > todayUtc });
}
const level = (n: number) => (n === 0 ? '' : n === 1 ? 'l1' : n === 2 ? 'l2' : n <= 4 ? 'l3' : 'l4');
const activeDays = cells.filter((c) => c.count > 0).length;
const activityDays = JSON.stringify([...perDay.keys()]);

const typeIcon = { leetcode: 'fas fa-code', course: 'fas fa-graduation-cap', journal: 'fas fa-book-open' };
---

<BaseLayout title="Dashboard" description={siteConfig.description}>
  <div class="px-1">
    <header class="mb-4">
      <span class="lt-eyebrow mb-2"><i class="fas fa-seedling me-1"></i> Learning in public</span>
      <h1 class="dynamic-title mb-2">Learning AI Engineering</h1>
      <p class="lead text-muted mb-3">
        My LeetCode practice, the courses I'm taking with notes, and a journal of what I'm learning along the way.
      </p>
      {siteConfig.mainSiteUrl && (
        <a href={siteConfig.mainSiteUrl} class="btn btn-sm btn-outline-primary rounded-pill px-3">
          Blog &amp; projects <i class="fas fa-arrow-right ms-1"></i>
        </a>
      )}
    </header>

    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <a href="/leetcode/" class="lt-card lt-stat d-block">
          <div class="lt-stat-value">{solved.length}</div>
          <div class="lt-stat-label">LeetCode solutions logged</div>
        </a>
      </div>
      <div class="col-6 col-lg-3">
        <div class="lt-stat">
          <div class="lt-stat-value" id="streak" data-days={activityDays}>0</div>
          <div class="lt-stat-label">Day streak</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <a href="/courses/" class="lt-card lt-stat d-block">
          <div class="lt-stat-value">{inProgress.length}<span class="fs-6 text-muted fw-normal"> / {completed.length} done</span></div>
          <div class="lt-stat-label">Courses in progress</div>
        </a>
      </div>
      <div class="col-6 col-lg-3">
        <a href="/journal/" class="lt-card lt-stat d-block">
          <div class="lt-stat-value">{journal.length}</div>
          <div class="lt-stat-label">Journal entries</div>
        </a>
      </div>
    </div>

    <section class="lt-card mb-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="lt-section-title mb-0">Activity</h2>
        <span class="lt-meta">{activeDays} active day{activeDays === 1 ? '' : 's'} in the last year</span>
      </div>
      <div class="heatmap-scroll" id="heatmap-scroll">
        <div class="heatmap" role="img" aria-label={`Learning activity heatmap: ${activeDays} active days in the last year`}>
          {cells.map((c) => (
            <div
              class={`heatmap-cell ${level(c.count)} ${c.future ? 'out' : ''}`}
              title={c.future ? undefined : `${c.count} ${c.count === 1 ? 'activity' : 'activities'} on ${formatDate(new Date(c.key))}`}
            ></div>
          ))}
        </div>
      </div>
      <div class="lt-meta mt-2 text-end">
        Less <span class="heatmap-legend"><span class="heatmap-cell"></span><span class="heatmap-cell l1"></span><span class="heatmap-cell l2"></span><span class="heatmap-cell l3"></span><span class="heatmap-cell l4"></span></span> More
      </div>
    </section>

    {siteConfig.leetcodeUsername && (
      <div class="mb-4">
        <LeetCodeCard />
      </div>
    )}

    <div class="row g-4">
      <div class="col-12 col-lg-7">
        <h2 class="lt-section-title">Recent activity</h2>
        {activity.length === 0 ? (
          <div class="lt-empty small">
            Nothing logged yet. Add your first entry with <code>npm run new leetcode|course|journal "Title"</code>.
          </div>
        ) : (
          <ul class="list-unstyled lt-card mb-0">
            {activity.slice(0, 10).map((a, i) => (
              <li class={`d-flex align-items-start gap-3 py-2 ${i > 0 ? 'border-top' : ''}`}>
                <i class={`${typeIcon[a.type]} text-muted mt-1`} style="width: 1rem"></i>
                <div class="flex-grow-1 min-w-0">
                  <a href={a.url} class="fw-semibold d-block text-truncate">{a.title}</a>
                  <span class="lt-meta">{a.detail}</span>
                </div>
                <span class="lt-meta text-nowrap">{formatDate(a.date)}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="col-12 col-lg-5">
        <h2 class="lt-section-title">Currently learning</h2>
        {inProgress.length === 0 ? (
          <div class="lt-empty small">No courses in progress.</div>
        ) : (
          <div class="d-flex flex-column gap-2">
            {inProgress.map((c) => (
              <a href={courseUrl(c)} class="lt-card">
                <div class="lt-card-title fs-6">{c.data.title}</div>
                {c.data.provider && <div class="lt-meta mb-2">{c.data.provider}</div>}
                <div class="d-flex align-items-center gap-2">
                  <div class="lt-progress flex-grow-1"><span style={`width:${c.data.progress}%`}></span></div>
                  <span class="lt-meta">{c.data.progress}%</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // The streak is computed in the browser so it stays correct between site rebuilds.
  const el = document.getElementById('streak');
  if (el) {
    const days = new Set(JSON.parse(el.dataset.days || '[]') as string[]);
    const key = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const d = new Date();
    // A streak is still alive if today has no entry yet but yesterday does.
    if (!days.has(key(d))) d.setDate(d.getDate() - 1);
    let streak = 0;
    while (days.has(key(d))) {
      streak++;
      d.setDate(d.getDate() - 1);
    }
    el.textContent = String(streak);
  }

  // Show the most recent weeks first on narrow screens.
  const scroller = document.getElementById('heatmap-scroll');
  if (scroller) scroller.scrollLeft = scroller.scrollWidth;
</script>
